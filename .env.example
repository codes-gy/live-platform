# ── Backend (Spring) ──
DB_URL=jdbc:postgresql://localhost:5432/live
DB_USERNAME=live
DB_PASSWORD=live
JWT_SECRET=32자-이상의-임의-문자열로-교체하세요
JWT_ACCESS_TOKEN_TTL=12h
# 운영(HTTPS)에서는 true
COOKIE_SECURE=false
# 심사용 테스트 계정(streamer@test.com · viewer@test.com)
TEST_ACCOUNTS_ENABLED=true
TEST_ACCOUNT_PASSWORD=test1234!
CORS_ALLOWED_ORIGINS=http://localhost:3000

# LiveKit Cloud (https://cloud.livekit.io → Settings → Keys)
# 로컬 시험: docker compose --profile livekit up -d 후 ws://localhost:7880 · devkey · secret
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Frontend (Next.js) ──
# 브라우저의 /api 요청을 넘길 백엔드 주소. 빌드할 때 읽힌다
BACKEND_URL=http://localhost:8080
