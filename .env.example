# ── Backend (Spring) ──
DB_URL=jdbc:postgresql://localhost:5432/live
DB_USERNAME=live
DB_PASSWORD=live
JWT_SECRET=32자-이상의-임의-문자열로-교체하세요
JWT_ACCESS_TOKEN_TTL=12h
# 운영(HTTPS)에서는 true
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# LiveKit Cloud (https://cloud.livekit.io → Settings → Keys)
# 로컬 시험: docker compose --profile livekit up -d 후 ws://localhost:7880 · devkey · secret
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 도네이션: 토스페이먼츠 "API 개별 연동" 테스트 키(test_ck_ · test_sk_). 개발자센터 또는 공식 문서의 테스트 키
# 비어 있으면 후원 주문 · 승인 API가 503(PAYMENT_NOT_CONFIGURED)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 녹화 · 다시보기(Cloudflare R2, 비공개 버킷). 비어 있으면 녹화 없이 방송만 한다
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Frontend (Next.js) ──
# 브라우저의 /api 요청을 넘길 백엔드 주소. 빌드할 때 읽힌다
BACKEND_URL=http://localhost:8080
