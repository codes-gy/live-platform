# docker-compose.prod.yml 용. .env.prod로 복사해 값을 채운다(커밋 금지)
# 서비스 공개 주소(https://…). scripts/self-host.sh up이 Tailscale Funnel 주소로 자동 갱신
PUBLIC_URL=https://<기기 이름>.<tailnet>.ts.net
DB_PASSWORD=긴-무작위-문자열
JWT_SECRET=32자-이상의-무작위-문자열
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
